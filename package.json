  "description": "MCP server that exposes the Clarion Assistant language server to AI agents with the IDE closed",
  "license": "MIT",
  "type": "module",
  "bin": { "clarion-lsp-mcp": "dist/index.js" },
  "files": ["dist", "README.md", "LICENSE"],
