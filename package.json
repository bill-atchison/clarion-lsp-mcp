  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "vscode-jsonrpc": "^9.0.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  }
}
